# Copy this file to .env and fill it in. Never share or commit .env.

# Required: the bot token from the Discord Developer Portal (Bot tab -> Reset Token).
DISCORD_TOKEN=

# Optional: the channel to post the notice in (right-click channel -> Copy Channel ID).
# Leave blank to use the server's System Messages channel, which is where
# Discord's own "X joined the server" messages go.
WELCOME_CHANNEL_ID=

# Optional: if another bot (MEE6, Carl-bot, etc.) posts your normal welcome message,
# put that bot's user ID here (right-click the bot -> Copy User ID) so the notice waits
# for its welcome. Separate several IDs with commas.
# Leave blank if your welcome is Discord's built-in join message.
WELCOME_BOT_ID=

# Optional: the most seconds to wait for the normal welcome before posting anyway.
WAIT_TIMEOUT_SECONDS=15
